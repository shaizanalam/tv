# ==========================================
# DriveFrame TV Environment Configuration
# ==========================================

# 1. Supabase Configuration
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# 2. Google OAuth 2.0 (Google Drive Integration)
# Scope required: https://www.googleapis.com/auth/drive.readonly
GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-google-client-secret
GOOGLE_REDIRECT_URI=http://localhost:3000/api/auth/drive/callback

# 3. Security & Token Vault Encryption
# Generate a 32-byte hex key using: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
DRIVE_TOKEN_ENCRYPTION_KEY=0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef

# 4. TV Device Session Secret (HMAC Signing)
TV_DEVICE_JWT_SECRET=super-secret-tv-token-signer-key-here

# 5. Application Host
NEXT_PUBLIC_APP_URL=http://localhost:3000
