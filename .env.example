# ==========================================
# DriveFrame TV Environment Configuration
# ==========================================

# 1. Family Password Vault Authentication
# Option A: Strong Salted PBKDF2 Hash (Recommended for production on Vercel)
# Generate using: node scripts/generate-password-hash.mjs "YourFamilyPassword"
FAMILY_PASSWORD_SALT=your-generated-hex-salt
FAMILY_PASSWORD_HASH=your-generated-pbkdf2-hex-hash

# Option B: Direct Shared Password (Alternative)
FAMILY_PASSWORD=your-family-password-here

# Session Signing Secret (HMAC-SHA256 for secure HttpOnly cookie)
SESSION_SECRET=generate-a-32-byte-secret-hex-key-here

# Session Lifetime (in days, default: 7)
SESSION_MAX_AGE_DAYS=7

# 2. Google OAuth 2.0 / API Keys
GOOGLE_API_KEY=your-google-api-key-if-using-private-quota

# 3. TV Device Session Secret (HMAC Signing)
TV_DEVICE_JWT_SECRET=super-secret-tv-token-signer-key-here

# 4. Application Host
NEXT_PUBLIC_APP_URL=http://localhost:3000
